<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CrowLink.App\CrowLink.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\CrowLink.App\Views\MainWindow.xaml"
          Link="Fixtures\MainWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CrowLink.App\Views\SettingsWindow.xaml"
          Link="Fixtures\SettingsWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CrowLink.App\Views\HelpWindow.xaml"
          Link="Fixtures\HelpWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CrowLink.App\app.manifest"
          Link="Fixtures\app.manifest"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
