<Window x:Class="CrowLink.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrowLink 1.5 설정" Width="510" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource PageBrush}">
    <Window.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style x:Key="AutoCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Text="Settings" />
                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}" Text="CrowLink 1.5 · 연결, 승인 및 Mobile Touchpad" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" Background="{DynamicResource NavSelectedBrush}" BorderBrush="{DynamicResource NavSelectedBorderBrush}" BorderThickness="1" CornerRadius="7">
                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding AutomationStatusText}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="자동 승인" />
                        <TextBlock Margin="0,3,0,11" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="켜진 기능은 상대 PC 요청을 확인창 없이 처리합니다. 신뢰할 수 있는 사설망에서만 사용하세요." />
                        <CheckBox Style="{StaticResource AutoCheckStyle}" IsChecked="{Binding AutoApproveConnect}">
                            <StackPanel><TextBlock FontSize="10" FontWeight="SemiBold" Text="Connect 자동 승인" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="들어오는 연결 요청을 즉시 허용" /></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource AutoCheckStyle}" IsChecked="{Binding AutoApproveShare}">
                            <StackPanel><TextBlock FontSize="10" FontWeight="SemiBold" Text="Share 자동 실행" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="파일 드롭 즉시 전송 · 수신 클립보드 즉시 적용" /></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource AutoCheckStyle}" IsChecked="{Binding AutoApproveControl}">
                            <StackPanel><TextBlock FontSize="10" FontWeight="SemiBold" Text="Control 자동 승인" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="원격 키보드·마우스 제어 요청을 즉시 허용" /></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource AutoCheckStyle}" Margin="0" IsChecked="{Binding AutoApproveExplorer}">
                            <StackPanel><TextBlock FontSize="10" FontWeight="SemiBold" Text="Explorer 자동 승인" /><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="Explorer 드래그 패키지를 즉시 수신" /></StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,9,0,0" Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="장치 및 화면" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="장치 이름" /><TextBox Margin="0,5,0,0" Padding="8,6" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="화면 테마" /><ComboBox Margin="0,5,0,0" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="수신 폴더" />
                        <TextBox Margin="0,5,0,0" Padding="8,6" Text="{Binding ReceiveFolder}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,9,0,0" Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Mobile Touchpad" />
                        <CheckBox Margin="0,8,0,0" Foreground="{DynamicResource InkBrush}" IsChecked="{Binding EnableMobileTouchpad}" Content="CrowLink 시작 시 모바일 서버 실행" />
                        <CheckBox Margin="0,7,0,0" Foreground="{DynamicResource InkBrush}" IsChecked="{Binding MobileLocalNetworkOnly}" Content="사설 로컬 네트워크에서만 접속 허용" />
                        <CheckBox Margin="0,7,0,0" Foreground="{DynamicResource InkBrush}" IsChecked="{Binding MobilePointerAcceleration}" Content="포인터 가속 사용" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="포인터 감도" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MobileSensitivity}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9" Text="{Binding MobileSensitivity, StringFormat={}{0:0.0}x}" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="스크롤 속도" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MobileScrollSpeed}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9" Text="{Binding MobileScrollSpeed, StringFormat={}{0:0.0}x}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="Mobile 포트" />
                            <TextBox Grid.Column="1" Padding="8,5" Text="{Binding MobileTouchpadPort}" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Text="모든 연결은 PC에서 매번 승인" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,9,0,0" Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="TCP 포트" /><TextBox Margin="0,5,0,0" Padding="8,6" Text="{Binding TcpPort}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="검색 UDP 포트" /><TextBox Margin="0,5,0,0" Padding="8,6" Text="{Binding DiscoveryPort}" /></StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource MutedBrush}" Text="{Binding TrustedDeviceCount, StringFormat=과거 승인 장치 {0}개}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,7,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="취소" />
                <Button Padding="18,8" Click="Save_Click" Content="저장" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
