<Window x:Class="CrowLink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CrowLink.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CrowLink Connect/Share/Control" Width="730" Height="550" MinWidth="680" MinHeight="510"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DarkCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style x:Key="NavIconButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource SoftTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#37B7E6" BlurRadius="20" ShadowDepth="0" Opacity="0.78" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NavSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SoftTextBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="35" Height="35" Margin="0,0,9,0" Background="{DynamicResource HeaderIconBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9">
                        <Viewbox Margin="7">
                            <Path Fill="{DynamicResource AccentBrush}" Data="M2,15 C5,7 10,3 18,3 C15,6 15,10 18,13 C14,13 11,15 9,19 C8,16 6,15 2,15 Z M14,5 L22,2 L18,9 Z" />
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold" Text="CrowLink 1.5" />
                        <TextBlock Margin="0,1,0,0" FontSize="8" Foreground="{DynamicResource SoftTextBrush}"
                                   Text="PC CONNECT / SHARE / CONTROL / MOBILE TOUCHPAD" />
                        <TextBlock Margin="0,1,0,0" FontSize="7.5" Foreground="{DynamicResource MutedBrush}"
                                   Text="© 2026 CrowScienceLab · 누구나 자유롭게 사용할 수 있습니다." />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,6" VerticalAlignment="Center" CornerRadius="8"
                        Background="{DynamicResource StatusPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding ConnectionStatusBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="{Binding ConnectionStatusText}" />
                        <Border Width="1" Height="13" Margin="9,0" Background="{DynamicResource LineBrush}" />
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding MobileStateBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMobileSessionActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" FontSize="8" FontWeight="SemiBold" Text="{Binding MobileHeaderText}" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" VerticalAlignment="Center"
                        Click="OpenHelpButton_Click" ToolTip="기능별 사용법 열기">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontSize="12" FontWeight="Bold" Text="?" />
                        <TextBlock VerticalAlignment="Center" FontSize="9" Text="도움말" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="5" Padding="8,5" VerticalAlignment="Center" Background="{DynamicResource AutomationPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7">
                    <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Text="{Binding AutomationSummary}" />
                </Border>
                <Button Grid.Column="7" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,72,0"
                    Command="{Binding OpenSettingsCommand}" Content="설정" />
                <StackPanel Grid.Column="7" Margin="0,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Panel.ZIndex="3">
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="23" Height="23" Padding="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Click="MinimizeButton_Click" Content="—" ToolTip="최소화" />
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="23" Height="23" Padding="0" Margin="2,0,0,0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Click="MaximizeButton_Click" Content="□" ToolTip="최대화" />
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="23" Height="23" Padding="0" Margin="2,0,0,0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Click="CloseButton_Click" Content="×" ToolTip="닫기" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
                <UniformGrid Rows="1" Columns="5">
                    <Button Style="{StaticResource NavIconButtonStyle}" Tag="{Binding IsConnectSelected}" Command="{Binding ShowConnectCommand}" ToolTip="Connect">
                        <StackPanel>
                            <Viewbox Width="27" Height="27" HorizontalAlignment="Center"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,7 L10,7 L10,17 L3,17 Z M14,4 L21,4 L21,14 L14,14 Z M10,10 L14,10" /></Viewbox>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="CONNECT" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavIconButtonStyle}" Tag="{Binding IsShareSelected}" Command="{Binding ShowShareCommand}" ToolTip="Share">
                        <StackPanel>
                            <Viewbox Width="27" Height="27" HorizontalAlignment="Center"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,5 L10,5 L12,8 L21,8 L21,19 L4,19 Z M8,14 L17,14 M14,11 L17,14 L14,17" /></Viewbox>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="SHARE" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavIconButtonStyle}" Tag="{Binding IsControlSelected}" Command="{Binding ShowControlCommand}" ToolTip="Control">
                        <StackPanel>
                            <Viewbox Width="27" Height="27" HorizontalAlignment="Center"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,4 L14,13 L10,14 L13,20 L10,21 L7,15 L4,18 Z M16,5 L21,5 L21,10" /></Viewbox>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="CONTROL" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavIconButtonStyle}" Tag="{Binding IsExplorerSelected}" Command="{Binding ShowExplorerCommand}" ToolTip="Explorer">
                        <StackPanel>
                            <Viewbox Width="27" Height="27" HorizontalAlignment="Center"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,6 L9,6 L11,9 L21,9 L21,19 L3,19 Z M8,14 L16,14 M14,11 L17,14 L14,17" /></Viewbox>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="EXPLORER" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavIconButtonStyle}" Tag="{Binding IsMobileSelected}" Command="{Binding ShowMobileCommand}" ToolTip="Mobile Touchpad">
                        <StackPanel>
                            <Viewbox Width="27" Height="27" HorizontalAlignment="Center"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,3 L17,3 Q19,3 19,5 L19,21 Q19,23 17,23 L7,23 Q5,23 5,21 L5,5 Q5,3 7,3 Z M9,6 L15,6 M10,20 L14,20 M12,10 C10,10 9,12 10,14 C11,16 14,16 15,14 C16,12 14,10 12,10 Z" /></Viewbox>
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="MOBILE" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="4" Visibility="{Binding ConnectVisibility}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Connect" />
                    <TextBlock Margin="0,3,0,11" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Text="가까운 PC를 고르고, 상대방이 승인하면 연결됩니다." />
                    <Border Style="{StaticResource DarkCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="THIS DEVICE" />
                                <TextBlock Margin="0,4,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding DeviceName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding ServiceStatus}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,8,0,0" Style="{StaticResource DarkCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" Style="{StaticResource SectionLabelStyle}" Text="검색된 장치" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DeviceInfo}">
                                        <Grid MinWidth="240">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding StatusText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,7,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}"
                                       Text="{Binding SelectedDevice.StatusText, TargetNullValue=장치를 검색 중입니다…}" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding ConnectCommand}" Content="연결 요청" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DisconnectCommand}" Content="연결 끊기" />
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="안전한 연결" />
                        <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SoftTextBrush}"
                                   Text="기본은 모든 요청을 직접 확인합니다. 필요한 기능만 설정에서 자동 승인할 수 있습니다." />
                        <Border Margin="0,12,0,0" Padding="10" Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" Text="PROTOCOL 5 · LAN TEST BUILD&#x0a;신뢰할 수 있는 사설망에서 사용하세요." />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="4" Visibility="{Binding ShareVisibility}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Share" />
                    <TextBlock Margin="0,3,0,11" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Text="보낼 목록을 확인한 뒤 파일과 클립보드를 영구 복사합니다." />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.7*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource DarkCardStyle}" Height="188" Padding="7" AllowDrop="True"
                                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                                <Border BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="1" CornerRadius="9" Background="{Binding DropZoneBackground}">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,9,0" FontSize="23" Foreground="{DynamicResource AccentBrush}" Text="＋" />
                                            <StackPanel><TextBlock FontWeight="SemiBold" Text="파일 또는 폴더 추가" /><TextBlock FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding ShareDropHint}" /></StackPanel>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource LineBrush}" />
                                        <Grid Grid.Row="2" Margin="0,5,0,0">
                                            <ListBox ItemsSource="{Binding PendingTransfers}" BorderThickness="0" Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2" Padding="8,4" Background="{DynamicResource QueueItemBrush}" CornerRadius="6" BorderBrush="{DynamicResource QueueItemBorderBrush}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding KindText}" />
                                                                <Button Grid.Column="2" Width="23" Height="23" Padding="0" Style="{StaticResource DangerButtonStyle}" Content="×"
                                                                        Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource SoftTextBrush}"
                                                       Visibility="{Binding EmptyPendingVisibility}" Text="보낼 목록이 비어 있습니다." />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearPendingCommand}" Content="목록 비우기" />
                                <Button Grid.Column="2" Command="{Binding SendQueuedCommand}" Content="{Binding SendQueueButtonText}" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Clipboard" />
                                <Button Margin="0,10,0,0" Command="{Binding SendTextClipboardCommand}" Content="텍스트 보내기" />
                                <Button Margin="0,6,0,0" Command="{Binding SendImageClipboardCommand}" Content="이미지 보내기" />
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding ClipboardStatus}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Margin="2,15,0,7" FontSize="12" FontWeight="SemiBold" Text="Activity" />
                    <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type models:TransferItem}">
                                <Border Margin="0,0,0,7" Style="{StaticResource DarkCardStyle}" Padding="10">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock Grid.Column="1" Margin="9,0" Foreground="{DynamicResource AccentBrush}" FontSize="9" Text="{Binding PercentText}" /><Button Grid.Column="2" Style="{StaticResource CancelTransferButtonStyle}" Content="취소" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" /></Grid>
                                        <ProgressBar Margin="0,7,0,3" Height="4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                        <Grid><TextBlock FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding DetailText}" /><TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding StatusText}" /></Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type models:ClipboardHistoryItem}">
                                <Border Margin="0,0,0,7" Style="{StaticResource DarkCardStyle}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding DetailText}" /></StackPanel><TextBlock Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" Text="{Binding StatusText}" /></Grid></Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="4" Visibility="{Binding ControlVisibility}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Control" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Text="Windows 디스플레이 설정처럼 PC별 화면 위치를 직접 배치합니다." /></StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="9,5" Background="{DynamicResource QueueItemBrush}" CornerRadius="7"><TextBlock FontSize="9" Foreground="{DynamicResource AccentTextBrush}" Text="모니터를 드래그해 배치" /></Border>
                    </Grid>
                    <Border Margin="0,11,0,0" Style="{StaticResource DarkCardStyle}" Padding="10">
                        <StackPanel>
                            <Grid Margin="2,0,2,8">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Monitor topology" />
                                <TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="실제 해상도 · 위치 · DPI 반영" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource MonitorGridBrush}"><GeometryDrawing.Pen><Pen Brush="{DynamicResource MonitorGridLineBrush}" Thickness="1" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                                <ItemsControl x:Name="MonitorCanvas" Height="220" ItemsSource="{Binding MonitorTopologyItems}" ClipToBounds="True" SizeChanged="MonitorCanvas_SizeChanged">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            <Setter Property="Panel.ZIndex" Value="2" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:MonitorTopologyItem}">
                                            <Border Width="{Binding Width}" Height="{Binding Height}" Tag="{Binding GroupKey}" Cursor="SizeAll"
                                                    PreviewMouseLeftButtonDown="MonitorItem_MouseLeftButtonDown" PreviewMouseMove="MonitorItem_MouseMove"
                                                    PreviewMouseLeftButtonUp="MonitorItem_MouseLeftButtonUp" LostMouseCapture="MonitorItem_LostMouseCapture"
                                                    CornerRadius="5">
                                                <Border.ToolTip>
                                                    <ToolTip Background="{DynamicResource ToolTipBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource ToolTipBorderBrush}" BorderThickness="1" Padding="9">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding ComputerLabel, Mode=OneWay}" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SoftTextBrush}"><Run Text="{Binding Resolution, Mode=OneWay}" /><Run Text=" · 배율 " /><Run Text="{Binding ScaleText, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource MonitorRemoteBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource VioletBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsLocal}" Value="True"><Setter Property="Background" Value="{DynamicResource MonitorLocalBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="6,4">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{Binding ComputerShortLabel}" />
                                                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" FontWeight="Bold" Text="{Binding DisplayLabel}" />
                                                        <TextBlock HorizontalAlignment="Center" Margin="0,1,0,0" FontSize="8" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding ScaleText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,9,0,0" Style="{StaticResource DarkCardStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="130" /><ColumnDefinition Width="8" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" FontWeight="SemiBold" Text="Keyboard &amp; Mouse" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="배치 방향에 맞춰 화면 경계를 자동 선택합니다." /></StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding MouseEdges}" SelectedItem="{Binding SelectedMouseEdge}" />
                            <Button Grid.Column="4" Command="{Binding ToggleRemoteMouseCommand}" Content="{Binding RemoteMouseButtonText}" />
                        </Grid>
                    </Border>
                    <Grid Margin="2,7,2,0"><TextBlock FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding RemoteMouseStatus}" TextWrapping="Wrap" /><TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" Text="한/영·키보드·단축키 포함 · Ctrl+Alt+Esc 비상 종료" /></Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4" Visibility="{Binding ExplorerVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="11" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Explorer Bridge · OLE Lab" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Text="빠른 이동: 원하는 폴더에 놓으면 CrowLink 임시 원본을 자동 삭제합니다." /></StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.82*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.18*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource DarkCardStyle}" Height="180" Padding="7" AllowDrop="True" DragEnter="ExplorerDrop_DragEnter" DragLeave="ExplorerDrop_DragLeave" Drop="ExplorerDrop_Drop">
                            <Border BorderBrush="{DynamicResource VioletBrush}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource ExplorerPanelBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="38" Height="38"><Path Stroke="{DynamicResource ExplorerAccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,7 L10,7 L12,10 L22,10 L22,20 L3,20 Z M8,15 L17,15 M14,12 L18,15 L14,18" /></Viewbox>
                                    <TextBlock Margin="0,9,0,0" FontSize="12" FontWeight="SemiBold" Text="Explorer 파일 놓기" />
                                    <TextBlock Margin="16,5" TextAlignment="Center" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="PC 1에서 전송 · PC 2에서 승인&#x0a;준비 카드를 원하는 폴더로 이동" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border Margin="0,9,0,0" Padding="10" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding ExplorerStatus}" /></Border>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}" Padding="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding ExplorerPackages}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3" Padding="11" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" PreviewMouseLeftButtonDown="ExplorerPackage_MouseLeftButtonDown" MouseMove="ExplorerPackage_MouseMove">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="7" Background="{DynamicResource ExplorerPanelBrush}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ExplorerAccentBrush}" FontWeight="Bold" Text="↗" /></Border><StackPanel Grid.Column="1"><TextBlock FontSize="9" Foreground="{DynamicResource ExplorerAccentBrush}" Text="{Binding DirectionText}" /><TextBlock Margin="0,3,0,0" FontSize="10" FontWeight="SemiBold" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding DragHint}" /></StackPanel></Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Visibility="{Binding EmptyExplorerPackagesVisibility}" Text="Explorer 패키지가 없습니다.&#x0a;준비 완료 항목을 Explorer로 끌어내세요." />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Visibility="{Binding MobileVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="11" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Mobile Touchpad" />
                    <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SoftTextBrush}" Text="앱 설치 없이 휴대폰 브라우저를 이 PC의 무선 터치패드로 사용합니다." />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DarkCardStyle}" Padding="11">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Width="188" Height="188" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" Background="White" CornerRadius="8">
                                <Grid>
                                    <Image Source="{Binding MobileQrImage}" Stretch="Uniform" SnapsToDevicePixels="True" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                <TextBlock HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" Text="QR을 스캔하거나 아래 주소를 여세요." />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding MobileUrl}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource DarkCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel><TextBlock Style="{StaticResource SectionLabelStyle}" Text="PAIRING CODE" /><TextBlock Margin="0,3,0,0" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding MobilePairingCode}" /></StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,6" Background="{DynamicResource StatusPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"><TextBlock FontSize="9" Text="{Binding MobileDeviceText}" /></Border>
                                </Grid>
                                <TextBlock Margin="0,9,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}" TextWrapping="Wrap" Text="코드를 입력한 휴대폰도 PC의 승인창에서 매번 허용해야 합니다. 승인 후 코드는 즉시 교체됩니다." />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,8,0,0" Style="{StaticResource DarkCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding MobileStateBrush}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMobileSessionActive}" Value="True">
                                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.18" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="상태" />
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0" FontSize="9.5" Foreground="{DynamicResource SoftTextBrush}" Text="{Binding MobileStatus}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" Text="{Binding MobileStatistics}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Command="{Binding ToggleMobileServerCommand}" Content="{Binding MobileServerButtonText}" />
                                    <Button Grid.Column="2" Command="{Binding DisconnectMobileCommand}" Content="{Binding MobileStopButtonText}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMobileSessionActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshMobileCodeCommand}" Content="새 코드" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyMobileUrlCommand}" Content="주소 복사" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="2,7,2,0" FontSize="8.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="한 손가락 이동·탭 / 두 손가락 탭·스크롤 / 더블탭 후 이동으로 드래그&#x0a;Ctrl+Alt+Esc로 모바일 입력을 즉시 차단할 수 있습니다." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
