<Window x:Class="CrowLink.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrowLink 1.5 도움말" Width="650" Height="700" MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <Style x:Key="HelpCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style x:Key="HelpTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SoftTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock FontSize="23" FontWeight="Bold" Text="CrowLink 사용법" />
                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource SoftTextBrush}"
                           Text="PC CONNECT / FILE SHARE / MOUSE KEYBOARD CONTROL" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6"
                    Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="같은 네트워크에서 사용" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource HelpCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="1. CONNECT · PC 연결" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="두 PC에서 CrowLink를 실행하고 같은 LAN에 연결합니다. 검색된 장치에서 상대 PC를 선택한 뒤 ‘연결 요청’을 누르세요. 상대 PC가 장치 이름을 확인하고 수락하면 상단 연결 상태가 ‘연결됨’으로 바뀝니다. 기본 설정에서는 새 연결마다 상대방의 승인이 필요하며, ‘연결 끊기’로 언제든 세션을 종료할 수 있습니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="5. MOBILE · 휴대폰 무선 터치패드" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="PC와 휴대폰을 같은 Wi-Fi에 연결하고 Mobile 메뉴에서 서버를 시작합니다. QR을 스캔하고 6자리 코드를 입력한 뒤 PC에서 요청을 허용하세요. 연결되면 인증창이 닫히고 브라우저 전체화면으로 전환됩니다. 터치패드는 상대 이동·탭·두 손가락 스크롤을 지원하며 감도와 가속을 조절할 수 있습니다. 펜 모드는 선택한 PC 모니터와 휴대폰 입력 영역을 절대좌표로 매칭하므로 가로 방향 사용을 권장합니다. 휴대폰에서 중지하거나 연결이 끊어지면 PC 서버도 자동으로 중지됩니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="2. SHARE · 파일과 클립보드 공유" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="연결된 PC를 선택한 다음 파일이나 폴더를 전송 영역에 놓으면 먼저 보낼 목록에 추가됩니다. 목록의 × 버튼으로 잘못 고른 항목을 제거하고 ‘전송 시작’을 누르세요. 진행 중인 전송은 ‘취소’할 수 있으며, 받은 파일은 설정된 수신 폴더에 저장됩니다. 텍스트 또는 이미지 클립보드도 버튼으로 전송할 수 있고 전송 기록은 Activity에 남습니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="3. CONTROL · 마우스와 키보드 제어" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="Monitor topology에서 각 PC의 실제 모니터 배치를 확인하고 PC 묶음을 드래그해 서로의 위치를 지정합니다. 상대 PC가 제어 요청을 수락한 뒤 입력 공유를 시작하면, 지정한 화면 경계로 마우스를 밀어 상대 PC로 이동할 수 있습니다. 한/영 전환, 일반 키 입력과 단축키도 함께 전달됩니다. 제어를 즉시 끝내려면 Ctrl+Alt+Esc를 누르세요. Ctrl+Alt+Delete는 Windows 보안 정책상 전송되지 않습니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="4. EXPLORER · 원하는 폴더로 가져오기" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="송신 PC의 Explorer 파일이나 폴더를 CrowLink의 OLE Lab 영역에 놓습니다. 상대 PC가 전송을 수락하면 파일이 안전한 임시 수신 위치로 전달되고, 수신 PC의 CrowLink에 ‘Explorer로 드래그할 준비 완료’ 카드가 나타납니다. 이 카드를 원하는 Windows Explorer 폴더로 드래그하세요. 복사가 성공하면 CrowLink가 임시 원본을 자동으로 삭제합니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCardStyle}" Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource InfoBorderBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTitleStyle}" Text="안전 및 자동 승인" />
                        <TextBlock Style="{StaticResource HelpTextStyle}"
                                   Text="기본값은 Connect·Share·Control·Explorer 요청을 매번 확인하는 방식입니다. Mobile 입력은 6자리 임시 코드와 PC의 매회 승인을 모두 통과해야 합니다. 신뢰할 수 있는 사설 네트워크에서만 사용하세요. 기본 포트는 TCP 45100, UDP 45101, Mobile 45102입니다." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="10" FontWeight="SemiBold" Text="© 2026 CrowScienceLab" />
                <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="{DynamicResource SoftTextBrush}"
                           Text="누구나 자유롭게 사용할 수 있는 무료 유틸리티입니다." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="UpdateButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Click="UpdateButton_Click" Content="업데이트 확인 · 다운로드" />
                <Button Padding="20,8" Click="CloseButton_Click" Content="닫기" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
